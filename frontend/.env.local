# ── Backend origin used by the Next.js dev proxy (/api/* -> API_ORIGIN/*) ──
# The NestJS backend runs on port 3000.
API_ORIGIN=http://127.0.0.1:3000

# Base path the browser uses. Keep as /api so the proxy (and thus CORS-free
# requests) are used. Change only if you serve the API from another domain
# AND enable app.enableCors() in NestJS main.ts.
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3001
