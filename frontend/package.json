{
  "name": "blog-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (fa/en) RTL-first frontend for the NestJS blog API",
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3001",
