{
  "name": "blog-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (fa/en) RTL-first frontend for the NestJS blog API",
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "lint": "next lint",
    "test:social": "tsx --test tests/social-state.test.ts && tsx --tsconfig tests/tsconfig.json --test tests/social-react.test.tsx",
    "test:api": "node tests/social-api.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "next-intl": "^4.3.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-test-renderer": "^19.3.0",
    "postcss": "^8.4.49",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
